{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cos:PutBucketACL"
      ],
      "resource": [
        "qcs::cos:ap-guangzhou:uid/[UIN]:*-[APPID]"
      ],
      "condition": {
        "string_equal": {
          "cos:x-cos-acl": [
            "private"
          ]
        }
      }
    }
  ]
}
