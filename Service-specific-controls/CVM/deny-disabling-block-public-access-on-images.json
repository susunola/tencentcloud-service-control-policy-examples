{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cvm:ModifyImageSharePermission",
        "cvm:ModifyImageAttribute"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "string_not_equal": {
          "qcs:PrincipalTag/image-admin": "true"
        }
      }
    }
  ]
}
