{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cvm:TerminateInstances",
        "cvm:StopInstances"
      ],
      "resource": [
        "qcs::cvm::uin/[UIN]:instance/*"
      ],
      "condition": {
        "string_not_equal": {
          "qcs:PrincipalTag/ops-admin": "true"
        }
      }
    }
  ]
}
