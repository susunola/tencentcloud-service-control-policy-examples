{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cvm:RunInstances"
      ],
      "resource": [
        "qcs::cvm::*:instance/*"
      ],
      "condition": {
        "string_not_equal": {
          "cvm:InstanceType": [
            "[APPROVED_INSTANCE_TYPE_1]",
            "[APPROVED_INSTANCE_TYPE_2]"
          ]
        }
      }
    }
  ]
}
