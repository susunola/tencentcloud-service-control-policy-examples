{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cam:DeletePolicy",
        "cam:ModifyPolicy",
        "cam:DetachUserPolicy",
        "cam:DetachGroupPolicy",
        "cam:DetachRolePolicy"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "string_not_equal": {
          "qcs:PrincipalTag/policy-admin": "true"
        }
      }
    }
  ]
}
