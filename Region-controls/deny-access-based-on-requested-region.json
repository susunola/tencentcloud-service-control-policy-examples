{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "not_action": [
        "cam:*",
        "organization:*",
        "sts:*",
        "cloudaudit:*",
        "monitor:*",
        "billing:*",
        "account:*",
        "tag:*",
        "cvm:DescribeRegions",
        "cvm:DescribeZones"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "string_not_equal": {
          "qcs:PrincipalArn": "qcs::cam::uin/[UIN]:role/[PRIVILEGED_ROLE]"
        }
      }
    }
  ]
}
