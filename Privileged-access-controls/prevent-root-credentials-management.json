{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cam:CreateLoginProfile",
        "cam:ModifyLoginProfile",
        "cam:DeleteLoginProfile",
        "cam:CreateAccessKey",
        "cam:ModifyAccessKey",
        "cam:DeleteAccessKey",
        "cam:UpdateUser",
        "cam:DeleteUser"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "string_equal": {
          "qcs:user_type": "root"
        }
      }
    }
  ]
}
