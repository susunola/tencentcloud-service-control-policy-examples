{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "*"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "string_equal": {
          "qcs:user_type": "root"
        },
        "string_not_equal_if_exist": {
          "cam:RequestedAction": [
            "cam:DescribeAccountSummary",
            "cos:PutBucketPolicy",
            "cos:DeleteBucketPolicy"
          ]
        }
      }
    }
  ]
}
