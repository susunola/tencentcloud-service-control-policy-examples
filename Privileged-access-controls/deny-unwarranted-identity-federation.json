{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cam:CreateSAMLProvider",
        "cam:ModifySAMLProvider",
        "cam:DeleteSAMLProvider",
        "cam:CreateOIDCProvider",
        "cam:ModifyOIDCProvider",
        "cam:DeleteOIDCProvider"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "string_not_equal": {
          "qcs:PrincipalTag/identity-admin": "true"
        }
      }
    }
  ]
}
