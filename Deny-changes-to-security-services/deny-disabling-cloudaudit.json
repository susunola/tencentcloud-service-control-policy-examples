{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cloudaudit:DeleteAuditTrack",
        "cloudaudit:ModifyAuditTrack",
        "cloudaudit:StopLogging",
        "cloudaudit:UpdateAudit"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "string_not_equal": {
          "qcs:PrincipalTag/security-admin": "true"
        }
      }
    }
  ]
}
