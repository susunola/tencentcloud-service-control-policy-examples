{
  "version": "2.0",
  "statement": [
    {
      "effect": "allow",
      "action": [
        "cvm:RunInstances",
        "cos:PutBucket",
        "vpc:CreateVpc",
        "clb:CreateLoadBalancer"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "for_any_value:string_equal": {
          "qcs:request_tag": [
            "cost-center&[COST_CENTER]"
          ]
        }
      }
    }
  ]
}
