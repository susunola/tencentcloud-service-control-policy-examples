{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "cbs:ModifyDiskAttributes",
        "cbs:ModifyDiskExtraPerformance"
      ],
      "resource": [
        "*"
      ],
      "condition": {
        "string_not_equal_if_exist": {
          "cbs:Encrypt": "ENCRYPT"
        }
      }
    }
  ]
}
