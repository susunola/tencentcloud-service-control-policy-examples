{
  "version": "2.0",
  "statement": [
    {
      "effect": "deny",
      "action": [
        "kms:DeleteKey",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion"
      ],
      "resource": [
        "qcs::kms:ap-guangzhou:uin/[UIN]:key/*"
      ],
      "condition": {
        "string_not_equal": {
          "qcs:PrincipalTag/security-admin": "true"
        }
      }
    }
  ]
}
